[Unit]
Description=LungCancerReport invitation research application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lungreport
Group=lungreport
WorkingDirectory=/opt/lungcancerreport
EnvironmentFile=/opt/lungcancerreport/.env.production
Environment=APP_ENV=production REQUIRE_LOGIN=true COOKIE_SECURE=true PORT=10000 LISTEN_HOST=127.0.0.1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/lungcancerreport/.venv/bin/python /opt/lungcancerreport/serve.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=100

[Install]
WantedBy=multi-user.target
